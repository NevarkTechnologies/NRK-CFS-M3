
#MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
#MONGO_URI=mongodb://127.0.0.1:27017/nevark_local
CLIENT_ORIGIN=
# Set either GOOGLE_APPLICATION_CREDENTIALS to your service account file path
# or FIREBASE_SERVICE_ACCOUNT to the raw JSON string for firebase-admin authentication
# FIREBASE_SERVICE_ACCOUNT={...}
PORT=
MONGO_URI=
# CODEX EDITS: Explicit database name avoids connecting to an unintended default.
MONGO_DB_NAME=
REDIS_URL=redis://127.0.0.1:6379
JWT_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# CODEX EDITS: Independent secret configured on the Razorpay webhook dashboard.
RAZORPAY_WEBHOOK_SECRET=
# Paytm gateway. Staging base URL: https://securestage.paytmpayments.com
# Production base URL: https://secure.paytmpayments.com (with production MID/key/website)
PAYTM_MID=
PAYTM_MERCHANT_KEY=
PAYTM_WEBSITE=WEBSTAGING
PAYTM_BASE_URL=https://securestage.paytmpayments.com
# Public https URL of this API (e.g. https://api.example.com) — used to build
# the Paytm callback URL for the web checkout flow.
PUBLIC_BASE_URL=
FIREBASE_SERVICE_ACCOUNT=
