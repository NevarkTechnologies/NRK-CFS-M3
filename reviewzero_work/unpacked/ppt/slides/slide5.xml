<?xml version="1.0" ?><p:sld xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" xmlns:p="http://schemas.openxmlformats.org/presentationml/2006/main"><p:cSld><p:spTree><p:nvGrpSpPr><p:cNvPr id="1" name="Shape 122"/><p:cNvGrpSpPr/><p:nvPr/></p:nvGrpSpPr><p:grpSpPr><a:xfrm><a:off x="0" y="0"/><a:ext cx="0" cy="0"/><a:chOff x="0" y="0"/><a:chExt cx="0" cy="0"/></a:xfrm></p:grpSpPr><p:sp><p:nvSpPr><p:cNvPr id="123" name="Shape 123"/><p:cNvSpPr txBox="1"><a:spLocks noGrp="1"/></p:cNvSpPr><p:nvPr><p:ph type="title"/></p:nvPr></p:nvSpPr><p:spPr><a:xfrm><a:off x="311700" y="593367"/><a:ext cx="8520600" cy="763500"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom></p:spPr><p:txBody><a:bodyPr spcFirstLastPara="1" wrap="square" lIns="91425" tIns="91425" rIns="91425" bIns="91425" anchor="t" anchorCtr="0"><a:noAutofit/></a:bodyPr><a:lstStyle/><a:p><a:pPr marL="0" lvl="0" indent="0"><a:spcBef><a:spcPts val="0"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft><a:buNone/></a:pPr><a:r><a:rPr lang="en-IN" dirty="0"><a:latin typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/><a:cs typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/></a:rPr><a:t>Literature Review / Background Study</a:t></a:r><a:endParaRPr dirty="0"><a:latin typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/><a:cs typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/></a:endParaRPr></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="124" name="Shape 124"/><p:cNvSpPr txBox="1"><a:spLocks noGrp="1"/></p:cNvSpPr><p:nvPr><p:ph type="body" idx="1"/></p:nvPr></p:nvSpPr><p:spPr><a:xfrm><a:off x="311700" y="1734925"/><a:ext cx="8060775" cy="2363856"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom></p:spPr><p:txBody><a:bodyPr spcFirstLastPara="1" wrap="square" lIns="91425" tIns="91425" rIns="91425" bIns="91425" anchor="t" anchorCtr="0"><a:noAutofit/></a:bodyPr><a:lstStyle/><a:p><a:pPr lvl="0"><a:spcAft><a:spcPts val="120"/></a:spcAft><a:buNone/></a:pPr><a:r><a:rPr lang="en-IN" sz="1500" b="1" dirty="0"><a:latin typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/><a:cs typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/></a:rPr><a:t>Existing Systems</a:t></a:r></a:p><a:p><a:pPr lvl="0"><a:spcAft><a:spcPts val="120"/></a:spcAft></a:pPr><a:r><a:rPr lang="en-IN" sz="1350" b="1" dirty="0"><a:latin typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/><a:cs typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/></a:rPr><a:t xml:space="preserve">Cross-view geo-localization </a:t></a:r><a:r><a:rPr lang="en-IN" sz="1350" dirty="0"><a:latin typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/><a:cs typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/></a:rPr><a:t>(University-1652 [1], VIGOR [2]) established UAV-to-ground image matching, but only for structured Western cities.</a:t></a:r></a:p><a:p><a:pPr lvl="0"><a:spcAft><a:spcPts val="120"/></a:spcAft></a:pPr><a:r><a:rPr lang="en-IN" sz="1350" b="1" dirty="0"><a:latin typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/><a:cs typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/></a:rPr><a:t xml:space="preserve">Vision-language models </a:t></a:r><a:r><a:rPr lang="en-IN" sz="1350" dirty="0"><a:latin typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/><a:cs typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/></a:rPr><a:t>(CLIP [3]) enable place recognition, yet match a single modality — no fusion of text + image + GPS.</a:t></a:r></a:p><a:p><a:pPr lvl="0"><a:spcAft><a:spcPts val="120"/></a:spcAft></a:pPr><a:r><a:rPr lang="en-IN" sz="1350" b="1" dirty="0"><a:latin typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/><a:cs typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/></a:rPr><a:t xml:space="preserve">UAV last-mile delivery </a:t></a:r><a:r><a:rPr lang="en-IN" sz="1350" dirty="0"><a:latin typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/><a:cs typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/></a:rPr><a:t>(Zipline, Wing [7]) is operationally proven but GPS-only, with no visual delivery confirmation.</a:t></a:r></a:p><a:p><a:pPr lvl="0"><a:spcAft><a:spcPts val="120"/></a:spcAft></a:pPr><a:r><a:rPr lang="en-IN" sz="1350" b="1" dirty="0"><a:latin typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/><a:cs typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/></a:rPr><a:t xml:space="preserve">AI routing and edge AI </a:t></a:r><a:r><a:rPr lang="en-IN" sz="1350" dirty="0"><a:latin typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/><a:cs typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/></a:rPr><a:t>(2023–2025) improve dynamic route planning and real-time on-board obstacle avoidance.</a:t></a:r></a:p><a:p><a:pPr lvl="0"><a:spcAft><a:spcPts val="300"/></a:spcAft></a:pPr><a:r><a:rPr lang="en-IN" sz="1350" b="1" dirty="0"><a:latin typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/><a:cs typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/></a:rPr><a:t xml:space="preserve">Indian scene datasets </a:t></a:r><a:r><a:rPr lang="en-IN" sz="1350" dirty="0"><a:latin typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/><a:cs typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/></a:rPr><a:t>(IDD [4]) cover road driving only — no aerial-to-ground data for Indian rooftops or landmarks.</a:t></a:r></a:p><a:p><a:pPr lvl="0"><a:spcAft><a:spcPts val="120"/></a:spcAft><a:buNone/></a:pPr><a:r><a:rPr lang="en-IN" sz="1500" b="1" dirty="0"><a:latin typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/><a:cs typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/></a:rPr><a:t>Research Gap addressed by NRK</a:t></a:r></a:p><a:p><a:pPr lvl="0"><a:spcAft><a:spcPts val="120"/></a:spcAft></a:pPr><a:r><a:rPr lang="en-IN" sz="1350" dirty="0"><a:latin typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/><a:cs typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/></a:rPr><a:t>No India-specific cross-view dataset → NRK captures rooftops, compound walls, water tanks, and landmark addresses.</a:t></a:r></a:p><a:p><a:pPr lvl="0"><a:spcAft><a:spcPts val="120"/></a:spcAft></a:pPr><a:r><a:rPr lang="en-IN" sz="1350" dirty="0"><a:latin typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/><a:cs typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/></a:rPr><a:t>No multimodal address verification → NRK fuses ground photo + text + GPS (trimodal).</a:t></a:r></a:p><a:p><a:pPr lvl="0"><a:spcAft><a:spcPts val="120"/></a:spcAft></a:pPr><a:r><a:rPr lang="en-IN" sz="1350" dirty="0"><a:latin typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/><a:cs typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/></a:rPr><a:t>GPS-denied final-meter problem → NRK adds a visual-language matching fallback.</a:t></a:r></a:p><a:p><a:pPr lvl="0"><a:spcAft><a:spcPts val="120"/></a:spcAft></a:pPr><a:r><a:rPr lang="en-IN" sz="1350" dirty="0"><a:latin typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/><a:cs typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/></a:rPr><a:t>No edge-offload verification → NRK runs cross-view matching on ESP32 drones via server offloading.</a:t></a:r></a:p></p:txBody></p:sp></p:spTree><p:extLst><p:ext uri="{BB962C8B-B14F-4D97-AF65-F5344CB8AC3E}"><p14:creationId xmlns:p14="http://schemas.microsoft.com/office/powerpoint/2010/main" val="2609037261"/></p:ext></p:extLst></p:cSld><p:clrMapOvr><a:masterClrMapping/></p:clrMapOvr></p:sld>