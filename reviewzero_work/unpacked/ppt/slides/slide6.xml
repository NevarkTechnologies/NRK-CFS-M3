<?xml version="1.0" ?><p:sld xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" xmlns:p="http://schemas.openxmlformats.org/presentationml/2006/main"><p:cSld><p:spTree><p:nvGrpSpPr><p:cNvPr id="1" name="Shape 122"/><p:cNvGrpSpPr/><p:nvPr/></p:nvGrpSpPr><p:grpSpPr><a:xfrm><a:off x="0" y="0"/><a:ext cx="0" cy="0"/><a:chOff x="0" y="0"/><a:chExt cx="0" cy="0"/></a:xfrm></p:grpSpPr><p:sp><p:nvSpPr><p:cNvPr id="123" name="Shape 123"/><p:cNvSpPr txBox="1"><a:spLocks noGrp="1"/></p:cNvSpPr><p:nvPr><p:ph type="title"/></p:nvPr></p:nvSpPr><p:spPr><a:xfrm><a:off x="311700" y="593367"/><a:ext cx="8520600" cy="763500"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom></p:spPr><p:txBody><a:bodyPr spcFirstLastPara="1" wrap="square" lIns="91425" tIns="91425" rIns="91425" bIns="91425" anchor="t" anchorCtr="0"><a:noAutofit/></a:bodyPr><a:lstStyle/><a:p><a:pPr marL="0" lvl="0" indent="0"><a:spcBef><a:spcPts val="0"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft><a:buNone/></a:pPr><a:r><a:rPr lang="en-GB" dirty="0"><a:latin typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/><a:cs typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/></a:rPr><a:t>Hardware and Software Requirements</a:t></a:r><a:endParaRPr dirty="0"><a:latin typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/><a:cs typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/></a:endParaRPr></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="124" name="Shape 124"/><p:cNvSpPr txBox="1"><a:spLocks noGrp="1"/></p:cNvSpPr><p:nvPr><p:ph type="body" idx="1"/></p:nvPr></p:nvSpPr><p:spPr><a:xfrm><a:off x="311700" y="1540423"/><a:ext cx="8403675" cy="4545619"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom></p:spPr><p:txBody><a:bodyPr spcFirstLastPara="1" wrap="square" lIns="91425" tIns="91425" rIns="91425" bIns="91425" anchor="t" anchorCtr="0"><a:noAutofit/></a:bodyPr><a:lstStyle/><a:p><a:pPr lvl="0"><a:spcAft><a:spcPts val="150"/></a:spcAft><a:buNone/></a:pPr><a:r><a:rPr lang="en-IN" sz="1600" b="1" dirty="0"><a:latin typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/><a:cs typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/></a:rPr><a:t>Hardware</a:t></a:r></a:p><a:p><a:pPr lvl="0"><a:spcAft><a:spcPts val="150"/></a:spcAft></a:pPr><a:r><a:rPr lang="en-IN" sz="1400" dirty="0"><a:latin typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/><a:cs typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/></a:rPr><a:t>Autonomous drone airframe (quad/hexacopter) with BLDC motors, ESCs, and propellers.</a:t></a:r></a:p><a:p><a:pPr lvl="0"><a:spcAft><a:spcPts val="150"/></a:spcAft></a:pPr><a:r><a:rPr lang="en-IN" sz="1400" dirty="0"><a:latin typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/><a:cs typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/></a:rPr><a:t>ESP32-class microcontroller for low-cost on-board (edge) compute with a Pixhawk / PX4 flight controller.</a:t></a:r></a:p><a:p><a:pPr lvl="0"><a:spcAft><a:spcPts val="150"/></a:spcAft></a:pPr><a:r><a:rPr lang="en-IN" sz="1400" dirty="0"><a:latin typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/><a:cs typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/></a:rPr><a:t>GPS/GNSS module, IMU, and obstacle-detection sensors (ultrasonic / LiDAR).</a:t></a:r></a:p><a:p><a:pPr lvl="0"><a:spcAft><a:spcPts val="150"/></a:spcAft></a:pPr><a:r><a:rPr lang="en-IN" sz="1400" dirty="0"><a:latin typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/><a:cs typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/></a:rPr><a:t>Onboard camera module for ground-image capture and computer vision.</a:t></a:r></a:p><a:p><a:pPr lvl="0"><a:spcAft><a:spcPts val="150"/></a:spcAft></a:pPr><a:r><a:rPr lang="en-IN" sz="1400" dirty="0"><a:latin typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/><a:cs typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/></a:rPr><a:t>LiPo battery, power-management unit, and telemetry / 4G-LTE communication link.</a:t></a:r></a:p><a:p><a:pPr lvl="0"><a:spcAft><a:spcPts val="300"/></a:spcAft></a:pPr><a:r><a:rPr lang="en-IN" sz="1400" dirty="0"><a:latin typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/><a:cs typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/></a:rPr><a:t>Ground GPU server/workstation (e.g., NVIDIA GPU) for model training and offloaded inference.</a:t></a:r></a:p><a:p><a:pPr lvl="0"><a:spcAft><a:spcPts val="150"/></a:spcAft><a:buNone/></a:pPr><a:r><a:rPr lang="en-IN" sz="1600" b="1" dirty="0"><a:latin typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/><a:cs typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/></a:rPr><a:t>Software</a:t></a:r></a:p><a:p><a:pPr lvl="0"><a:spcAft><a:spcPts val="150"/></a:spcAft></a:pPr><a:r><a:rPr lang="en-IN" sz="1400" dirty="0"><a:latin typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/><a:cs typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/></a:rPr><a:t>Python with PyTorch / TensorFlow for the cross-view and vision-language (CLIP) models.</a:t></a:r></a:p><a:p><a:pPr lvl="0"><a:spcAft><a:spcPts val="150"/></a:spcAft></a:pPr><a:r><a:rPr lang="en-IN" sz="1400" dirty="0"><a:latin typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/><a:cs typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/></a:rPr><a:t>OpenCV for computer vision; GDAL / GeoPandas and mapping APIs for geospatial route optimization.</a:t></a:r></a:p><a:p><a:pPr lvl="0"><a:spcAft><a:spcPts val="150"/></a:spcAft></a:pPr><a:r><a:rPr lang="en-IN" sz="1400" dirty="0"><a:latin typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/><a:cs typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/></a:rPr><a:t>ArduPilot / PX4 firmware and ESP-IDF for flight and edge control.</a:t></a:r></a:p><a:p><a:pPr lvl="0"><a:spcAft><a:spcPts val="150"/></a:spcAft></a:pPr><a:r><a:rPr lang="en-IN" sz="1400" dirty="0"><a:latin typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/><a:cs typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/></a:rPr><a:t>Flutter mobile app for order placement, image upload, and real-time tracking.</a:t></a:r></a:p><a:p><a:pPr lvl="0"><a:spcAft><a:spcPts val="150"/></a:spcAft></a:pPr><a:r><a:rPr lang="en-IN" sz="1400" dirty="0"><a:latin typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/><a:cs typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/></a:rPr><a:t>Cloud platform (AWS / Azure / GCP) with REST APIs for fleet management.</a:t></a:r></a:p><a:p><a:pPr lvl="0"><a:spcAft><a:spcPts val="150"/></a:spcAft></a:pPr><a:r><a:rPr lang="en-IN" sz="1400" dirty="0"><a:latin typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/><a:cs typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0"/></a:rPr><a:t>Database (MongoDB / PostgreSQL) with a web dashboard for analytics and reporting.</a:t></a:r></a:p></p:txBody></p:sp></p:spTree><p:extLst><p:ext uri="{BB962C8B-B14F-4D97-AF65-F5344CB8AC3E}"><p14:creationId xmlns:p14="http://schemas.microsoft.com/office/powerpoint/2010/main" val="3888950135"/></p:ext></p:extLst></p:cSld><p:clrMapOvr><a:masterClrMapping/></p:clrMapOvr></p:sld>